
<mvc:View
    controllerName="animal.adoption.userdashboard.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="userDashboardPage"
        title="Animal Adoption Tracker"
        class="userDashboardPage">

        <content>

            <VBox
                id="userDashboardMainVBox"
                class="dashboardContainer">

                <!-- WELCOME -->
                <VBox
                    id="userDashboardWelcomeBox"
                    class="welcomeSection">

                    <Title
                        id="userDashboardWelcomeTitle"
                        text="Welcome to Animal Adoption Tracker"
                        level="H1"
                        class="welcomeTitle" />

                    <Text
                        id="userDashboardWelcomeText"
                        text="Manage your applications, adoptions and profile in one place."
                        class="welcomeText" />

                </VBox>


                <!-- SUMMARY -->
                <Title
                    id="userDashboardSummaryTitle"
                    text="My Summary"
                    level="H2"
                    class="sectionTitle" />


                <!-- KPI CARDS -->
                <HBox
                    id="userDashboardSummaryHBox"
                    width="100%"
                    justifyContent="SpaceBetween"
                    wrap="NoWrap"
                    class="kpiRow">


                    <!-- APPLICATIONS -->
                    <GenericTile
                        id="userDashboardApplicationsTile"
                        header="My Applications"
                        class="dashboardKpiTile applicationsTile">

                        <TileContent
                            id="userDashboardApplicationsContent">

                            <NumericContent
                                id="userDashboardApplicationsValue"
                                value="{dashboard>/myApplications}"
                                icon="sap-icon://document-text"
                                valueColor="Neutral" />

                        </TileContent>

                    </GenericTile>


                    <!-- PENDING -->
                    <GenericTile
                        id="userDashboardPendingTile"
                        header="Pending Applications"
                        class="dashboardKpiTile pendingTile">

                        <TileContent
                            id="userDashboardPendingContent">

                            <NumericContent
                                id="userDashboardPendingValue"
                                value="{dashboard>/pendingApplications}"
                                icon="sap-icon://pending"
                                valueColor="Critical" />

                        </TileContent>

                    </GenericTile>


                    <!-- APPROVED -->
                    <GenericTile
                        id="userDashboardApprovedTile"
                        header="Approved Applications"
                        class="dashboardKpiTile approvedTile">

                        <TileContent
                            id="userDashboardApprovedContent">

                            <NumericContent
                                id="userDashboardApprovedValue"
                                value="{dashboard>/approvedApplications}"
                                icon="sap-icon://accept"
                                valueColor="Good" />

                        </TileContent>

                    </GenericTile>

                </HBox>


                <!-- SERVICES -->
                <Title
                    id="userDashboardServicesTitle"
                    text="Services"
                    level="H2"
                    class="sectionTitle servicesSectionTitle" />


                <HBox
                    id="userDashboardServicesHBox"
                    width="100%"
                    justifyContent="SpaceBetween"
                    wrap="NoWrap"
                    class="servicesRow">


                    <!-- BROWSE ANIMALS -->
                    <GenericTile
                        id="userDashboardBrowseAnimalsTile"
                        header="Browse Animals"
                        subheader="View Available Animals"
                        press=".onBrowseAnimalsPress"
                        class="serviceTile animalsServiceTile">

                        <TileContent
                            id="userDashboardBrowseAnimalsContent">

                            <ImageContent
                                id="userDashboardBrowseAnimalsIcon"
                                src="sap-icon://pet-care" />

                        </TileContent>

                    </GenericTile>


                    <!-- APPLICATIONS -->
                    <GenericTile
                        id="userDashboardApplicationsServiceTile"
                        header="My Applications"
                        subheader="Track Requests"
                        press=".onMyApplicationsPress"
                        class="serviceTile applicationsServiceTile">

                        <TileContent
                            id="userDashboardApplicationsServiceContent">

                            <ImageContent
                                id="userDashboardApplicationsServiceIcon"
                                src="sap-icon://document-text" />

                        </TileContent>

                    </GenericTile>


                    <!-- ADOPTIONS -->
                    <GenericTile
                        id="userDashboardAdoptionsTile"
                        header="My Adoptions"
                        subheader="Adoption History"
                        press=".onMyAdoptionsPress"
                        class="serviceTile adoptionsServiceTile">

                        <TileContent
                            id="userDashboardAdoptionsContent">

                            <ImageContent
                                id="userDashboardAdoptionsIcon"
                                src="sap-icon://accept" />

                        </TileContent>

                    </GenericTile>


                    <!-- PROFILE -->
                    <GenericTile
                        id="userDashboardProfileTile"
                        header="My Profile"
                        subheader="Manage Profile"
                        press=".onProfilePress"
                        class="serviceTile profileServiceTile">

                        <TileContent
                            id="userDashboardProfileContent">

                            <ImageContent
                                id="userDashboardProfileIcon"
                                src="sap-icon://employee" />

                        </TileContent>

                    </GenericTile>

                </HBox>


                <!-- APPLICATIONS SECTION -->

                <VBox
                    id="userApplicationsSection"
                    class="applicationsCard">

                    <HBox
                        id="myApplicationsHeader"
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <VBox
                            id="myApplicationsHeadingBox">

                            <Title
                                id="myApplicationsTitle"
                                text="My Adoption Applications"
                                level="H2"
                                class="applicationsTitle" />

                            <Text
                                id="myApplicationsSubtitle"
                                text="Track the status of your adoption requests."
                                class="applicationsSubtitle" />

                        </VBox>


                        <Button
                            id="myApplicationsRefreshButton"
                            text="Refresh"
                            icon="sap-icon://refresh"
                            type="Transparent"
                            press=".onRefresh" />

                    </HBox>


                    <Table
                        id="myApplicationsTable"
                        items="{applications>/}"
                        class="applicationsTable">

                        <columns>

                            <Column
                                id="animalColumn">

                                <Text
                                    id="animalColumnText"
                                    text="Animal" />

                            </Column>

                            <Column
                                id="applicationDateColumn">

                                <Text
                                    id="applicationDateColumnText"
                                    text="Application Date" />

                            </Column>

                            <Column
                                id="applicationStatusColumn">

                                <Text
                                    id="applicationStatusColumnText"
                                    text="Status" />

                            </Column>

                            <Column
                                id="applicationReasonColumn">

                                <Text
                                    id="applicationReasonColumnText"
                                    text="Reason" />

                            </Column>

                            <Column
                                id="housingDetailsColumn">

                                <Text
                                    id="housingDetailsColumnText"
                                    text="Housing Details" />

                            </Column>

                        </columns>


                        <items>

                            <ColumnListItem
                                id="applicationListItemTemplate">

                                <cells>

                                    <Text
                                        id="applicationAnimalIdText"
                                        text="{applications>animal_ID}" />

                                    <Text
                                        id="applicationDateText"
                                        text="{applications>applicationDate}" />

                                    <ObjectStatus
                                        id="applicationStatusObjectStatus"
                                        text="{applications>status}" />

                                    <Text
                                        id="applicationReasonText"
                                        text="{applications>reasonForAdoption}" />

                                    <Text
                                        id="applicationHousingText"
                                        text="{applications>housingDetails}" />

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>
